{
	"name": "better-mathjax",
	"version": "2.1.0",
	"description": "Configurable MathJax autocompletion and snippets for Obsidian",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src tests",
		"test": "vitest run",
		"build:registry": "node scripts/build-registry.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "greasycat@github",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "^10.0.1",
		"@mathjax/mathjax-mhchem-font-extension": "4.1.3",
		"@types/node": "^24.0.0",
		"builtin-modules": "^5.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.0.0",
		"mathjax": "4.1.3",
		"obsidian": "1.14.4",
		"tslib": "^2.8.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "^4.1.0"
	}
}
